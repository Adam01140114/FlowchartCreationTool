  "groups": [],
  "defaultPdfProperties": {
    "pdfName": "DV-110 Temporary Restraining Order",
    "pdfFile": "form.pdf",
    "pdfPrice": "0"
  },
  "computedFields": [
    {
      "nameId": "restrained_person_relationship_to_protected_person",
      "_why": "DV-100 item 3 asks the relationship as boxes; this is the same answer in the few words item 2 has room for - the box holds about 29 characters, so each relationship is a word or two and the common pair, 'spouse/partner, co-parent', still fits. The words describe the restrained person, since item 2 is theirs.",
      "separator": ", ",
      "wordsWhenTicked": [
        {
          "when": "relationship_current_spouses_or_domestic_partners",
          "words": "spouse/partner"
        },
        {
          "when": "relationship_former_spouses_or_domestic_partners",
          "words": "ex-spouse/partner"
        },
        {
          "when": "relationship_engaged_or_formerly_engaged",
          "words": "(ex-)fiancé(e)"
        },
        {
          "when": "relationship_dating_or_formerly_dated",
          "words": "(ex-)dating partner"
        },
        {
          "when": "relationship_have_children_together",
          "words": "co-parent"
        },
        {
          "when": "relationship_relative_parent_stepparent_parent_in_law",
          "words": "parent (step/in-law)"
        },
        {
          "when": "relationship_relative_sibling_stepsibling_sibling_in_law",
          "words": "sibling (step/in-law)"
        },
        {
          "when": "relationship_relative_child_stepchild_adopted_child",
          "words": "child (step/adopted)"
        },
        {
          "when": "relationship_relative_grandparent",
          "words": "grandparent"
        },
        {
          "when": "relationship_relative_child_spouse",
          "words": "child's spouse"
        },
        {
          "when": "relationship_relative_grandchild",
          "words": "grandchild"
        },
        {
          "when": "relationship_live_or_lived_together",
          "words": "(ex-)household member"
        }
      ]
    }
  ],
  "alwaysShown": [
    {
      "question": "other_protected_people_yes_yes",
      "why": "Item 4 follows the address question whatever its answer. The prohibited-items question before it is optional, and an optional question passes its own condition on - both answers of the address gate - so this reads like a gate that gates nothing. It is not a gate; it is the rejoin."
    }
  ],
