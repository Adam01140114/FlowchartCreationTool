  "questions": {
    "amended_order_number": {
      "text": "What is the amendment number?",
      "conditional": {
        "onlyWhen": "order_type_amended"
      }
    },
    "restrained_person_prohibited_items_details": {
      "text": "What firearms, firearm parts, or ammunition does the restrained person have?",
      "conditional": {
        "onlyWhen": "restrained_person_has_prohibited_items"
      }
    },
    "firearms_review_hearing_date": {
      "text": "What is the date of the firearms compliance review hearing?",
      "conditional": {
        "onlyWhen": "firearms_compliance_review_hearing_required"
      }
    },
    "firearms_review_hearing_time": {
      "text": "What time is the firearms compliance review hearing?",
      "conditional": {
        "onlyWhen": "firearms_compliance_review_hearing_required"
      }
    },
    "firearms_review_hearing_department": {
      "text": "Which department is the firearms review hearing in?",
      "conditional": {
        "onlyWhen": "firearms_compliance_review_hearing_required"
      }
    },
    "firearms_review_hearing_room": {
      "text": "Which room is the firearms review hearing in?",
      "conditional": {
        "onlyWhen": "firearms_compliance_review_hearing_required"
      }
    },
    "no_contact_exception_other_explanation": {
      "text": "What is the other exception to the No-Contact Order?",
      "conditional": {
        "onlyWhen": "no_contact_exception_other"
      }
    },
    "stay_away_exception_other_explanation_line_1": {
      "text": "What is the other exception to the Stay-Away Order?",
      "conditional": {
        "onlyWhen": "stay_away_exception_other"
      }
    },
    "stay_away_exception_other_explanation_line_2": {
      "text": "Continue the other Stay-Away exception, if it needs a second line.",
      "conditional": {
        "onlyWhen": "stay_away_exception_other"
      }
    },
    "child_custody_other_form_name": {
      "text": "Which other custody or visitation form is attached?",
      "conditional": {
        "onlyWhen": "child_custody_other_form_attached"
      }
    },
    "protected_person_name": {
      "text": "Who is the protected person?"
    },
    "restrained_person_full_name": {
      "text": "Who is the restrained person?"
    },
    "court_name_and_street_address": {
      "text": "What is the court's name and street address?"
    },
    "hearing_date": {
      "text": "What is the hearing date?"
    },
    "hearing_time": {
      "text": "What time is the hearing?"
    },
    "judge_signature_date": {
      "text": "What date did the judge sign?"
    },
    "clerk_deputy_name": {
      "text": "Which deputy clerk completed the certificate?"
    },
    "clerk_certificate_date": {
      "text": "What date was the clerk's certificate completed?"
    },
    "attached_pages_count": {
      "text": "How many pages are attached?"
    },
    "attachment_other_form_name": {
      "text": "Which other form is attached?",
      "conditional": {
        "onlyWhen": "attachment_form_other"
      }
    },
    "move_out_address": {
      "text": "Which address must the restrained person move out of?"
    },
    "other_orders_details": {
      "text": "What are the other orders?"
    },
    "controlled_property_description": {
      "text": "Which property does the order cover?"
    },
    "stay_away_distance_yards": {
      "text": "How many yards must the restrained person stay away?"
    },
    "protect_animals_stay_away_distance_yards": {
      "text": "How many yards must the restrained person stay away from the animals?"
    },
    "no_contact_exception_child_communication": {
      "conditional": {
        "onlyWhen": "no_contact_exception_applies"
      }
    },
    "no_contact_exception_children_visits_only": {
      "conditional": {
        "onlyWhen": "no_contact_exception_applies"
      }
    },
    "no_contact_exception_other": {
      "conditional": {
        "onlyWhen": "no_contact_exception_applies"
      }
    },
    "stay_away_exception_child_exchange": {
      "conditional": {
        "onlyWhen": "stay_away_exception_applies"
      }
    },
    "stay_away_exception_child_visits": {
      "conditional": {
        "onlyWhen": "stay_away_exception_applies"
      }
    },
    "stay_away_exception_other": {
      "conditional": {
        "onlyWhen": "stay_away_exception_applies"
      }
    }
