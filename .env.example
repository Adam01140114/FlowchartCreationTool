# Auto Form Creator — copy this to .env and fill in real values.
# These are the same variable names the FormWiz project uses. .env is gitignored.

# Used by the AI generation endpoints (field config, form config, form HTML,
# form connections, help answers). Without it those routes return 503 and the
# rest of the tool still works.
OPENAI_API_KEY=

# Used by the Claude-backed generators.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional model overrides.
FORM_CONFIG_MODEL=
FORM_CONFIG_REVIEW_MODEL=
FORM_CONFIG_POLISH_MODEL=
FORM_CONFIG_SKIP_REVIEW=
FORM_CONNECTIONS_MODEL=

# Only needed for the publish / admin form-catalog routes (Firestore).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_ID=
