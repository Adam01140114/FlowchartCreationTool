  "computedFields": [
    {
      "nameId": "mc410_case_name_or_type",
      "_why": "The caption box 'Case Name/Type (if you know it)' has one answer in this packet: the form is only ever filed with a request for a domestic violence restraining order, and it is here only because the filer answered that they need an accommodation. So it is written when that answer is given, not asked.",
      "wordsWhenTicked": [
        {
          "when": "needs_disability_accommodation_yes",
          "words": "Domestic violence restraining order"
        }
      ]
    }
  ],
  "alwaysShown": [
    {
      "question": "mc410_helper_provided",
      "why": "The helper's contact line at the foot of page 1 is asked whatever the answer about more papers in item 5; it comes after that box only because the box is the last thing item 5 asks."
    },
    {
      "question": "mc410_accommodation_when",
      "why": "MC-410 item 3 asks every requester when the accommodation is needed; it follows item 1 only because it comes next."
    }
  ],
  "autofilledFields": [
    {
      "field": "mc410_signature_date",
      "from": [
        "current_date"
      ],
      "why": "The date beside the signature at the foot of page 1 has one correct answer and the form already knows it."
    },
    {
      "field": "mc410_signature_printed_name",
      "from": [
        "person_asking_protection_name"
      ],
      "why": "The typed name under the signature on page 1 is the name the filer gave in item 1."
    }
  ]
